HTTP_ADDR=:8082
SERVICE_NAME=space-service
SPACE_API_NETWORK=drp-dev_default
# Production path fetches RS256 keys from identity. Tests use a static test key, never alg none/HS256.
IDENTITY_JWKS_URL=http://localhost:8081/api/v1/auth/jwks
# Empty = in-memory catalog. Set after Flyway on drp-space-db.
DATABASE_URL=postgres://space_app:change-me-space@localhost:5432/drp?sslmode=disable
